# Copy to .env (same folder as docker-compose.yml) and change the secrets.
# Postgres credentials (used by the db container and by the api to connect).
POSTGRES_USER=fixmycampus
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=fixmycampus

# HMAC secret for signing JWTs. Must be >= 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# API port on the host and in the container.
PORT=3000

# Optional
# LOG_LEVEL=info
# AUTH_RATE_LIMIT=50   # requests per 15 min per IP on /auth/*; 0 disables
